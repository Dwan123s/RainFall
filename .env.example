# ==============================================================================
# RainSense — Smart Rainfall & Environmental Monitoring System
# Environment Configuration Template
# ==============================================================================

# Server Network Settings
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (NeonDB PostgreSQL or Local PostgreSQL)
# Example for NeonDB: postgresql://rainsense_owner:SECRET_PASS@ep-weather-123.ap-southeast-1.aws.neon.tech/rainsense?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rainsense?sslmode=disable"

# MQTT HiveMQ Cloud Configuration (Server-Side ONLY - Never expose to frontend!)
# HiveMQ Cloud uses TLS over port 8883
MQTT_BROKER_URL="tls://your-cluster-id.s1.eu.hivemq.cloud:8883"
MQTT_USERNAME="rainsense_station_user"
MQTT_PASSWORD="YourStrongMqttPasswordHere"
MQTT_CLIENT_ID="rainsense-backend-server"
MQTT_TOPIC_PREFIX="weather"

# Security & Authentication
JWT_SECRET="rainsense_super_secure_jwt_secret_key_at_least_32_characters"
ADMIN_EMAIL="admin@rainsense.io"
ADMIN_PASSWORD="Admin@ChangeMe123!"

# Application Operation Modes
# Set to 'true' to enable built-in realistic simulator (ideal for demo/testing before hardware arrives)
# Set to 'false' for live production MQTT ingestion from physical ESP32-S3
DEMO_MODE=true

# CORS Allowlist (comma separated)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Station Default Settings
DEFAULT_STATION_ID="RS-ESP32S3-01"
DEFAULT_CALIBRATION_MM_PER_TIP=0.25
DEFAULT_TIMEZONE="Asia/Ho_Chi_Minh"

# Next.js Frontend Environment Variables (apps/web/.env.local)
# NEXT_PUBLIC_API_URL="http://localhost:5000"
# NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"
# NEXT_PUBLIC_DEFAULT_DEVICE_ID="RS-ESP32S3-01"
