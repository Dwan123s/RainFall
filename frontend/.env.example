# ==============================================================================
# RainSense Frontend Dashboard (Next.js) - Environment Variables
# ==============================================================================

# Backend API URL (Express + Socket.IO Server)
# Cục bộ (Localhost):
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"

# Khi deploy lên Render / Vercel (thay bằng URL Backend Render thực tế):
# NEXT_PUBLIC_API_URL="https://rainsense-backend.onrender.com"
# NEXT_PUBLIC_SOCKET_URL="https://rainsense-backend.onrender.com"

# Trạm mặc định hiển thị trên Dashboard
NEXT_PUBLIC_DEFAULT_DEVICE_ID="RS-ESP32S3-01"

# Optional private URL used only by Next.js to proxy AI requests to Express.
# AI_BACKEND_URL="http://localhost:5000"
# Configure GEMINI_API_KEY on the backend, not in NEXT_PUBLIC_* variables.
