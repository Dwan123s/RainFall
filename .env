# ==============================================================================
# RainSense — Smart Rainfall & Environmental Monitoring System
# Production Configuration for ESP32-S3 Hardware & HiveMQ Cloud
# ==============================================================================

# Server Network Settings
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (NeonDB PostgreSQL Cloud or Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rainsense?sslmode=disable"

# MQTT HiveMQ Cloud Broker Configuration (TLS Port 8883)
# Thay your-cluster-id bằng Cluster URL thật của bạn trên HiveMQ Cloud:
# Ví dụ: tls://b918fxxxx.s1.eu.hivemq.cloud:8883
# Nếu dùng Mosquitto local / docker: mqtt://localhost:1883
MQTT_BROKER_URL="tls://mock-broker.hivemq.cloud:8883"
MQTT_USERNAME="rainsense_station_user"
MQTT_PASSWORD="YourStrongPassword"
MQTT_CLIENT_ID="rainsense-backend-server"
MQTT_TOPIC_PREFIX="weather"

# Security & Authentication
JWT_SECRET="rainsense_super_secure_jwt_secret_key_at_least_32_characters"
ADMIN_EMAIL="admin@rainsense.io"
ADMIN_PASSWORD="Admin@ChangeMe123!"

# Application Operation Modes (LIVE MODE: FALSE = Chờ nhận dữ liệu từ ESP32-S3 thực tế)
DEMO_MODE=false

# CORS Allowlist
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Station Default Settings (Cấu hình trạm phần cứng ESP32-S3)
DEFAULT_STATION_ID="RS-ESP32S3-01"
DEFAULT_CALIBRATION_MM_PER_TIP=0.25
DEFAULT_TIMEZONE="Asia/Ho_Chi_Minh"
